      "isDeleted": false,
      "boundElements": null,
      "updated": 1791598744465,
      "created": 1791598613655,
      "link": null,
      "locked": false,
      "text": "Now on the based of your experiences -> or your knowledge of the previous trek\nyou have completed -> or maybe your conversation with the medical personnel\nregarding these situation will help you decide to take action approriately",
      "fontSize": 63,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now on the based of your experiences -> or your knowledge of the previous trek you have completed -> or maybe your conversation with the medical personnel regarding these situation will help you decide to take action approriately",
