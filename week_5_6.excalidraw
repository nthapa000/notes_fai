      "link": null,
      "locked": false,
      "text": "e.g Lets say you have to trek ABC base camp and currently in\nmidway trek and your friends got blister in the leg and now you\nneed to decide and take actions. ",
      "fontSize": 63,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "e.g Lets say you have to trek ABC base camp and currently in midway trek and your friends got blister in the leg and now you need to decide and take actions. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "POWB52gJ_JAVTmyZnaUtg",
      "type": "text",
      "x": -2643.190218488082,
      "y": 972469.6488589154,
      "width": 2570.0001525878906,
      "height": 236.25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
